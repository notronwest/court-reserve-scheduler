# Credentials — never commit
.env

# Claude Code internals
.claude/

# Prototype scripts (moved to archive/)
archive/

# Cached schedule data (moved to cache/)
cache/

# Node (the repo root carries its own node_modules on hosts that run the
# TypeScript from here; ts/.gitignore only ever covered ts/node_modules/)
node_modules/

# Python
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Runtime artifacts (moved to logs/)
logs/

# History data (fetched at runtime)
history/

# Fixed-events cache (fetched at runtime, D-0056)
state/

# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Supabase CLI local cache (machine-local, not source)
supabase/.temp/

# Temp files (e.g. bootstrap write-then-move leftovers)
*.tmp

ppa_calendar_cache.json
