<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.whitemountain.contract-time</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/notronwest/data/web/wmpc/projects/court-reserve-scheduler/ts/ops/run-contract-time.sh</string>
    </array>

    <!-- Hourly (every 3600s). Each Contract Time occurrence is therefore looked at inside both its 48h and
         its 24h window; a ledger (state/contract-time-ledger.json) keeps a re-run from emailing twice. -->
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/notronwest/Library/Logs/court_reserve/launchd_contract_time.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/notronwest/Library/Logs/court_reserve/launchd_contract_time_err.log</string>
</dict>
</plist>
