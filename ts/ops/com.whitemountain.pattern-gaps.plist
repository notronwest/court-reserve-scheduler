<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.whitemountain.pattern-gaps</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/notronwest/data/web/wmpc/projects/court-reserve-scheduler/ts/ops/run-pattern-gaps.sh</string>
    </array>

    <!-- Daily at 8:45 AM — LAST of the three, after the 8:00 booker and the 8:30
         catch-up, so it only ever sees what those two left behind. It asks the
         question neither of them can: does every STANDING session actually exist? -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/notronwest/Library/Logs/court_reserve/launchd_pattern_gaps.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/notronwest/Library/Logs/court_reserve/launchd_pattern_gaps_err.log</string>
</dict>
</plist>
